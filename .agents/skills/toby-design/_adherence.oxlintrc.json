{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/chat/**",
              "components/core/**",
              "components/dashboard/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/toby-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:SF Pro Text|SF Pro|New York|Inter))/i]",
        "message": "Font not provided by the design system. Available: SF Pro Text, SF Pro, New York, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='AssistantMessage'] > JSXAttribute > JSXIdentifier[name!=/^(?:header|avatarSrc|children|footer|key|ref|className|style|children)$/]",
        "message": "<AssistantMessage> doesn't accept that prop. Declared props: header, avatarSrc, children, footer."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|accentSoft)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'accent' | 'accentSoft'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|wide|disabled|external|children|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, wide, disabled, external, children, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:bordered|prominent|plain|destructive)$/]",
        "message": "<Button> variant must be one of 'bordered' | 'prominent' | 'plain' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:leading|label|meta|onRemove|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: leading, label, meta, onRemove."
      },
      {
        "selector": "JSXOpeningElement[name.name='DashboardCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|stamp|lastRan|actions|children|showMore|key|ref|className|style|children)$/]",
        "message": "<DashboardCard> doesn't accept that prop. Declared props: title, stamp, lastRan, actions, children, showMore."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlowRunnerCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|stamp|running|error|onRun|key|ref|className|style|children)$/]",
        "message": "<FlowRunnerCard> doesn't accept that prop. Declared props: title, description, stamp, running, error, onRun."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:glyph|label|tone|size|filled|disabled|onClick|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: glyph, label, tone, size, filled, disabled, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:muted|faint|accent|inverted)$/]",
        "message": "<IconButton> tone must be one of 'muted' | 'faint' | 'accent' | 'inverted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='InlineStatusMessage'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|message|glyph|key|ref|className|style|children)$/]",
        "message": "<InlineStatusMessage> doesn't accept that prop. Declared props: tone, message, glyph."
      },
      {
        "selector": "JSXOpeningElement[name.name='InlineStatusMessage'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:success|error)$/]",
        "message": "<InlineStatusMessage> tone must be one of 'success' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='InputDock'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|placeholder|hint|contextPercent|attachments|loading|onChange|onSubmit|key|ref|className|style|children)$/]",
        "message": "<InputDock> doesn't accept that prop. Declared props: value, placeholder, hint, contextPercent, attachments, loading, onChange, onSubmit."
      },
      {
        "selector": "JSXOpeningElement[name.name='OnboardingTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|glyph|actionLabel|upNext|complete|onAction|key|ref|className|style|children)$/]",
        "message": "<OnboardingTile> doesn't accept that prop. Declared props: title, subtitle, glyph, actionLabel, upNext, complete, onAction."
      },
      {
        "selector": "JSXOpeningElement[name.name='PersonaFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|model|imageSrc|open|onClick|key|ref|className|style|children)$/]",
        "message": "<PersonaFooter> doesn't accept that prop. Declared props: name, model, imageSrc, open, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:progress|height|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: progress, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectChoice'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectChoice> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='SettingsCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<SettingsCard> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SettingsRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|showsDivider|children|key|ref|className|style|children)$/]",
        "message": "<SettingsRow> doesn't accept that prop. Declared props: title, description, showsDivider, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SettingsSectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<SettingsSectionHeader> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarActionItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|title|glyph|color|key|ref|className|style|children)$/]",
        "message": "<SidebarActionItem> doesn't accept that prop. Declared props: id, title, glyph, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|glyph|selected|trailing|onClick|key|ref|className|style|children)$/]",
        "message": "<SidebarRow> doesn't accept that prop. Declared props: title, subtitle, glyph, selected, trailing, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarSection'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|key|ref|className|style|children)$/]",
        "message": "<SidebarSection> doesn't accept that prop. Declared props: title, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Skeleton'] > JSXAttribute > JSXIdentifier[name!=/^(?:lines|height|key|ref|className|style|children)$/]",
        "message": "<Skeleton> doesn't accept that prop. Declared props: lines, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|placeholder|secure|minWidth|maxWidth|onChange|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: value, placeholder, secure, minWidth, maxWidth, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:style|title|message|actionLabel|onAction|onDismiss|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: style, title, message, actionLabel, onAction, onDismiss."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='style'] > Literal[value!=/^(?:success|error|progress)$/]",
        "message": "<Toast> style must be one of 'success' | 'error' | 'progress'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|disabled|label|onChange|key|ref|className|style|children)$/]",
        "message": "<Toggle> doesn't accept that prop. Declared props: checked, disabled, label, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='UserMessage'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|footer|key|ref|className|style|children)$/]",
        "message": "<UserMessage> doesn't accept that prop. Declared props: text, footer."
      },
      {
        "selector": "JSXOpeningElement[name.name='WorkStepRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|duration|count|glyph|active|expandable|expanded|onToggle|key|ref|className|style|children)$/]",
        "message": "<WorkStepRow> doesn't accept that prop. Declared props: title, body, duration, count, glyph, active, expandable, expanded, onToggle."
      }
    ]
  },
