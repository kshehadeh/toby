{
	"name": "@toby/cli",
	"version": "0.19.2",
	"description": "CLI-based tool for managing your life — email, calendar, todos, and more",
	"type": "module",
	"bin": {
		"toby": "./dist/cli.js"
	},
	"exports": {
		"./config": "@toby/core/config/index"
	},
	"scripts": {
		"build": "tsup",
		"dev": "bun src/cli.ts",
		"typecheck": "tsc --noEmit",
		"test": "bunx vitest run",
		"test:watch": "bunx vitest"
	},
	"dependencies": {
		"@ai-sdk/gateway": "^3.0.104",
		"@ai-sdk/openai": "^3.0.53",
		"@ai-sdk/provider": "^3.0.10",
		"@doist/todoist-sdk": "^10.1.0",
		"@mozilla/readability": "^0.6.0",
		"@slack/bolt": "^4.7.2",
		"@toby/core": "workspace:*",
		"ai": "^6.0.168",
		"chalk": "^5.3.0",
		"commander": "^12.1.0",
		"croner": "^10.0.1",
		"googleapis": "^140.0.0",
		"ink": "^7.0.1",
		"ink-multiline-input": "^0.1.0",
		"jira.js": "^5.3.1",
		"linkedom": "^0.18.12",
		"open": "^10.1.0",
		"react": "19.2.6",
		"react-devtools-core": "^7.0.1",
		"zod": "3"
	},
	"devDependencies": {
		"@types/node": "^25.6.0",
		"@types/react": "^19.2.2",
		"tsup": "^8.3.0",
		"typescript": "^5.6.0",
		"vitest": "^2.1.0"
	}
}
