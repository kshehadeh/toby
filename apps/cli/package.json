{
	"name": "@toby/cli",
	"version": "0.35.2",
	"description": "CLI-based tool for managing your life — email, calendar, todos, and more",
	"type": "module",
	"bin": {
		"toby": "./dist/cli.js"
	},
	"exports": {
		"./config": "@toby/core/config/index"
	},
	"scripts": {
		"build": "bun build ./src/cli.ts --outfile ./dist/cli.js --target=bun --banner \"#!/usr/bin/env node\"",
		"build:compile": "bun build ./src/cli.ts --compile --outfile ../../dist/toby",
		"dev": "bun src/cli.ts",
		"typecheck": "tsc --noEmit",
		"test": "bunx vitest run",
		"test:watch": "bunx vitest"
	},
	"dependencies": {
		"@toby/core": "workspace:*",
		"ai": "^6.0.168",
		"chalk": "^5.3.0",
		"commander": "^12.1.0",
		"croner": "^10.0.1",
		"ink": "^7.0.1",
		"ink-link": "^5.0.0",
		"react": "19.2.6",
		"react-devtools-core": "^7.0.1",
		"zod": "3"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"@types/node": "^25.6.0",
		"@types/react": "^19.2.2",
		"typescript": "^5.6.0",
		"vitest": "^2.1.0"
	}
}
