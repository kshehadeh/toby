{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": "nextjs",
	"installCommand": "cd ../.. && bun install --frozen-lockfile",
	"buildCommand": "bun run build",
	"ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ] && exit 0; git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" HEAD -- . ../../bun.lock ../../package.json",
	"redirects": [
		{
			"source": "/appcast.xml",
			"destination": "https://github.com/kshehadeh/toby/releases/latest/download/appcast.xml",
			"permanent": false
		}
	]
}
