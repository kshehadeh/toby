{
	"name": "email",
	"displayName": "Email (IMAP/SMTP)",
	"description": "Generic email integration using IMAP for reading and SMTP for sending, with a local SQLite cache",
	"version": "1.0.0",
	"protocolVersion": "1",
	"icon": "📧",
	"iconAsset": {
		"path": "assets/icon-48.png",
		"mimeType": "image/png"
	},
	"runtime": {
		"type": "bun",
		"entry": "src/index.ts"
	},
	"capabilities": ["chat"],
	"providerCategories": ["email"],
	"resources": ["inbox", "messages", "drafts", "outbox"],
	"events": {
		"poll": {
			"intervalSeconds": 300
		}
	}
}
