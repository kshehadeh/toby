{
	"name": "todoist",
	"displayName": "Todoist",
	"description": "Connect to Todoist to manage and summarize your tasks",
	"version": "1.0.0",
	"protocolVersion": "1",
	"icon": "✅",
	"iconAsset": {
		"path": "assets/icon-48.png",
		"mimeType": "image/png"
	},
	"runtime": {
		"type": "bun",
		"entry": "src/cli.ts"
	},
	"capabilities": ["chat"],
	"providerCategories": ["tasks"],
	"resources": ["tasks", "projects"]
}
