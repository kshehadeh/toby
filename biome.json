{
	"$schema": "https://biomejs.dev/schemas/1.9.0/schema.json",
	"files": {
		"ignore": [
			".build/**",
			"dist/**",
			".vercel/**",
			"apps/help-site/out/**",
			"apps/help-site/.next/**",
			"apps/help-site/next-env.d.ts",
			"apps/toby-app/**",
			".turbo/**",
			".agents/**",
			"package.json"
		]
	},
	"organizeImports": { "enabled": true },
	"linter": { "enabled": true, "rules": { "recommended": true } },
	"formatter": { "enabled": true, "indentStyle": "tab" }
}
