{
  "display_information": {
    "name": "Toby"
  },
  "features": {
    "bot_user": {
      "display_name": "Toby",
      "always_online": true
    }
  },
  "oauth_config": {
    "redirect_urls": [
      "http://localhost:9878/callback"
    ],
    "scopes": {
      "user": [
        "im:read",
        "channels:read",
        "channels:write",
        "channels:history",
        "im:history",
        "im:write",
        "search:read"
      ],
      "bot": [
        "chat:write",
        "app_mentions:read",
        "groups:history",
        "im:history",
        "channels:history"
      ]
    },
    "pkce_enabled": true
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.channels",
        "message.groups",
        "message.im"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false,
    "is_mcp_enabled": false
  }
}
