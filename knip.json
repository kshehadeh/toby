{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"workspaces": {
		"apps/cli": {
			"entry": ["src/cli.ts"],
			"project": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts"]
		},
		"packages/core": {
			"project": ["src/**/*.ts"]
		},
		"packages/helper-scripts": {
			"entry": ["src/**/*.ts"],
			"project": ["src/**/*.ts"]
		},
		"apps/help-site": {
			"entry": [
				"src/app/**/*.{ts,tsx}",
				"next.config.ts",
				"postcss.config.mjs"
			],
			"project": ["src/**/*.{ts,tsx}"]
		}
	},
	"ignoreDependencies": ["react", "lint-staged"],
	"ignoreBinaries": ["swift"]
}
