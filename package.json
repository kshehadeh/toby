{
	"name": "toby",
	"version": "0.19.5",
	"private": true,
	"description": "Toby monorepo — personal productivity CLI",
	"type": "module",
	"packageManager": "bun@1.3.10",
	"workspaces": ["apps/*", "packages/*"],
	"overrides": {
		"react": "19.2.6",
		"react-dom": "19.2.6"
	},
	"scripts": {
		"postinstall": "bunx patch-package && bun ./scripts/install-git-hooks.mjs",
		"build": "turbo run build",
		"build:audio-helper": "swift build -c release --package-path apps/audio-helper",
		"build:system-helper": "swift build -c release --package-path apps/macos-helper",
		"build:plugin:sample": "bun run --cwd apps/plugin-sample build",
		"build:plugins": "bun run build:plugin:sample",
		"build:executable": "bun run build:audio-helper && bun run build:system-helper && bun run build:plugins && mkdir -p ./dist && (cd apps/cli && bun build ./src/cli.ts --compile --outfile ../../dist/toby) && cp ./apps/audio-helper/.build/release/toby-audio-helper ./dist/toby-listener && cp ./apps/macos-helper/.build/release/toby-macos-helper ./dist/toby-macos",
		"build:release": "BUN_TARGET=bun-darwin-$(uname -m | sed 's/x86_64/x64/;s/arm64/arm64/') SWIFT_ARCH=$(uname -m) ./scripts/build-release-artifacts.sh",
		"dev": "bun run --cwd apps/cli dev",
		"dev:turbo": "turbo run dev --filter @toby/cli --log-prefix=none --ui=stream",
		"typecheck": "turbo run typecheck",
		"lint": "bunx biome check .",
		"lint:fix": "bunx biome check . --write",
		"format": "bunx biome format . --write",
		"test": "turbo run test",
		"test:watch": "bun run --cwd apps/cli test:watch",
		"release": "release-it",
		"release:dry": "release-it --dry-run",
		"release:ci": "bun ./scripts/release-ci.mjs",
		"docs:install": "bun install",
		"docs:start": "bun run --cwd apps/help-site start",
		"docs:build": "turbo run build --filter @toby/help-site"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"lint-staged": "^16.4.0",
		"patch-package": "^8.0.1",
		"release-it": "^20.0.1",
		"turbo": "^2.5.4",
		"typescript": "^5.6.0"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,jsonc}": ["bunx biome check --write"],
		"*.{js,jsx,ts,tsx}": ["bunx biome check --write"]
	}
}
