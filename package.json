{
  "name": "toby",
  "version": "0.199.2",
  "private": true,
  "description": "Toby — a native macOS assistant. This package only holds the help site and release tooling; the app is Swift (apps/toby-app).",
  "type": "module",
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/help-site"
  ],
  "scripts": {
    "postinstall": "bun ./scripts/install-git-hooks.mjs",
    "build:app": "bash ./scripts/build-app.sh",
    "app": "bun run build:app && open \"./dist/Toby (Dev).app\"",
    "dev": "bun run app",
    "dev:upgrade-available": "bash ./scripts/run-app-upgrade-available.sh",
    "dev:sandbox": "bash ./scripts/run-sandbox.sh",
    "app:screenshots": "bash ./scripts/run-app-screenshots.sh",
    "seed:home": "swift run --package-path apps/toby-app -c release toby-seed",
    "build:release": "./scripts/build-release-artifacts.sh",
    "build:dmg": "bun run build:release && ./scripts/build-dmg.sh",
    "test": "bun run test:swift",
    "test:swift": "bash scripts/prefetch-sparkle-spm-artifact.sh && swift test --package-path apps/toby-app",
    "lint": "bunx biome check .",
    "lint:fix": "bunx biome check . --write",
    "format": "bunx biome format . --write",
    "typecheck": "bun run --cwd apps/help-site typecheck",
    "release": "release-it",
    "release:dry": "release-it --dry-run",
    "release:ci": "bun ./scripts/release-ci.mjs",
    "docs:start": "bun run --cwd apps/help-site dev",
    "docs:build": "bun run --cwd apps/help-site build"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "release-it": "^20.2.1",
    "typescript": "^5.9.3"
  }
}
