{
	"name": "toby",
	"version": "0.17.4",
	"description": "CLI-based tool for managing your life — email, calendar, todos, and more",
	"type": "module",
	"bin": {
		"toby": "./dist/cli.js"
	},
	"scripts": {
		"postinstall": "bunx patch-package && bun ./scripts/install-git-hooks.mjs",
		"build": "tsup",
		"build:audio-helper": "swift build -c release --package-path helpers/toby-audio-helper",
		"build:system-helper": "swift build -c release --package-path helpers/toby-macos-helper",
		"build:plugin:sample": "bun run --cwd helpers/toby-plugin-sample build",
		"build:plugins": "bun run build:plugin:sample",
		"build:executable": "bun run build:audio-helper && bun run build:system-helper && bun run build:plugins && bun build ./src/cli.ts --compile --outfile ./dist/toby && mkdir -p ./dist && cp ./helpers/toby-audio-helper/.build/release/toby-audio-helper ./dist/toby-listener && cp ./helpers/toby-macos-helper/.build/release/toby-macos-helper ./dist/toby-macos",
		"dev": "bun src/cli.ts",
		"typecheck": "tsc --noEmit",
		"lint": "bunx biome check .",
		"lint:fix": "bunx biome check . --write",
		"format": "bunx biome format . --write",
		"test": "bunx vitest run",
		"test:watch": "bunx vitest",
		"release": "release-it",
		"release:dry": "release-it --dry-run",
		"release:ci": "bun ./scripts/release-ci.mjs",
		"docs:install": "npm --prefix help-site install",
		"docs:start": "npm --prefix help-site run start",
		"docs:build": "npm --prefix help-site run build"
	},
	"dependencies": {
		"@ai-sdk/gateway": "^3.0.104",
		"@ai-sdk/openai": "^3.0.53",
		"@doist/todoist-sdk": "^10.1.0",
		"@mozilla/readability": "^0.6.0",
		"@slack/bolt": "^4.7.2",
		"ai": "^6.0.168",
		"chalk": "^5.3.0",
		"commander": "^12.1.0",
		"croner": "^10.0.1",
		"googleapis": "^140.0.0",
		"ink": "^7.0.1",
		"ink-multiline-input": "^0.1.0",
		"jira.js": "^5.3.1",
		"linkedom": "^0.18.12",
		"open": "^10.1.0",
		"parse-duration": "^2.1.6",
		"react": "^19.2.0",
		"react-devtools-core": "^7.0.1",
		"zod": "3"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"@types/node": "^25.6.0",
		"@types/react": "^19.2.2",
		"lint-staged": "^16.4.0",
		"patch-package": "^8.0.1",
		"release-it": "^20.0.1",
		"tsup": "^8.3.0",
		"typescript": "^5.6.0",
		"vitest": "^2.1.0"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,jsonc}": [
			"bunx biome check --write"
		],
		"*.{js,jsx,ts,tsx}": [
			"bunx biome check --write"
		]
	}
}
